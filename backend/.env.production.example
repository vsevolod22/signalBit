# Strapi
NODE_ENV=production
HOST=0.0.0.0
PORT=1337
APP_KEYS=replace_1,replace_2,replace_3,replace_4
API_TOKEN_SALT=replace_with_random_secret
ADMIN_JWT_SECRET=replace_with_random_secret
TRANSFER_TOKEN_SALT=replace_with_random_secret
JWT_SECRET=replace_with_random_secret
ENCRYPTION_KEY=replace_with_random_secret
STRAPI_TELEMETRY_DISABLED=true

# PostgreSQL inside docker-compose.prod.yml
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=signalbit_cms
DATABASE_USERNAME=signalbit
DATABASE_PASSWORD=replace_with_strong_database_password
DATABASE_SSL=false

# Use * to allow every frontend without CORS errors.
# For production, prefer an exact comma-separated allowlist:
# CORS_ORIGINS=https://example.ru,https://www.example.ru
CORS_ORIGINS=*
CORS_ALLOW_VERCEL_PREVIEWS=false

# Public Strapi port on the server
STRAPI_BIND_ADDRESS=0.0.0.0
STRAPI_PORT=1337

# Optional SMTP. Leave SMTP_HOST empty to disable email delivery.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_REPLY_TO=

